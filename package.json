{
  "name": "my-keys",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:web": "expo export --platform web --output-dir dist",
    "scan:bundle": "node scripts/check-bundle-secrets.mjs dist",
    "scan:source": "node scripts/check-source-secrets.mjs .",
    "scan:android-config": "node scripts/check-source-secrets.mjs mobile/androidApp/build/generated/source/buildConfig",
    "verify:bundle": "npm run bundle:web && npm run scan:bundle",
    "prebuild": "expo prebuild",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "doctor": "node --use-system-ca node_modules/expo-doctor/bin/expo-doctor.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run scan:source",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:status": "node scripts/supabase-local.mjs status",
    "supabase:reset": "node scripts/supabase-local.mjs reset",
    "supabase:test": "node scripts/supabase-local.mjs test",
    "supabase:lint": "node scripts/supabase-local.mjs lint",
    "supabase:test:auth": "node scripts/test-supabase-auth-integration.mjs",
    "supabase:publishable-key": "node scripts/supabase-local.mjs publishableKey"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.18",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~57.0.1",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "supabase": "2.111.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@react-native/jest-preset": "0.86.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
