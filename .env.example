# Valores publicos del cliente. La publishable key no es un secreto; RLS sigue siendo obligatoria.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APP_ENV=development

# Nunca anadas aqui SUPABASE_SECRET_KEY, service_role ni claves del proveedor de email.
